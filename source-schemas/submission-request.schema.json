{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Source Schema Submission Request",
  "description": "Valid payload for POST /api/source-schemas/test-fetch and POST /api/source-schemas/community-submissions. Both routes intentionally allow anonymous access in pre-production only; see submission-api-and-validation.md and TODOs.md for production-blocking authentication requirements.",
  "type": "object",
  "required": ["type", "feedUrl", "schemaDefinition", "name", "description"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Human-readable name of the calendar source",
      "examples": ["La Center Community Calendar", "Seattle Parks & Recreation Events"]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "What this source publishes; 1-2 sentences",
      "examples": ["Public events from La Center, WA", "Official city events and announcements"]
    },
    "type": {
      "type": "string",
      "enum": ["Ics", "Rss", "JsonApi", "HtmlLite"],
      "description": "The source type; it must match pipeline.calendar.type in the v3 schemaDefinition."
    },
    "feedUrl": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^https://",
      "description": "Public HTTPS URL of the calendar feed. Credentials, fragments, private hosts, and credential-like query parameters are rejected. Community submissions cannot use authenticated feeds.",
      "examples": ["https://example.org/calendar.ics", "https://example.org/events/feed.rss"]
    },
    "schemaDefinition": {
      "type": "string",
      "maxLength": 200000,
      "description": "V3 schema definition as a JSON string (not a nested object); requires schemaVersion 3 and pipeline.",
      "examples": [
        "{\"schemaVersion\":3,\"pipeline\":{\"calendar\":{\"type\":\"Ics\",\"parser\":{}},\"event\":{\"type\":\"None\",\"input\":{\"mode\":\"none\"},\"parser\":{}}}}",
        "{\"schemaVersion\":3,\"pipeline\":{\"calendar\":{\"type\":\"Rss\",\"parser\":{\"mappings\":{\"title\":\"title\",\"startTime\":\"pubDate\",\"eventUrl\":\"link\"}}},\"event\":{\"type\":\"None\",\"input\":{\"mode\":\"none\"},\"parser\":{}}}}"
      ]
    },
    "metadata": {
      "type": "object",
      "description": "Optional metadata about the source. Use only documented fields and customAttributes fallback keys.",
      "properties": {
        "location": {
          "type": "string",
          "description": "Geographic location: city, state, region, or venue name",
          "examples": ["Seattle, WA", "Pike Place Market", "Washington State"]
        },
        "region": {
          "type": "string",
          "description": "State or region code",
          "examples": ["WA", "CA", "Pacific Northwest"]
        },
        "category": {
          "type": "string",
          "description": "Event category",
          "examples": ["community", "government", "entertainment", "education"]
        },
        "language": {
          "type": "string",
          "description": "ISO 639-1 language code",
          "examples": ["en", "es", "fr"]
        },
        "contactEmail": {
          "type": "string",
          "format": "email",
          "description": "Email for questions about this source"
        },
        "estimatedEventCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Approximate number of events published per month"
        },
        "eventStartNotBeforeDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Only include events whose UTC start date is on or after this date (YYYY-MM-DD)"
        },
        "eventFallbackUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "description": "Absolute public HTTPS URL without query or credentials, used when an event has no eventUrl"
        },
        "customAttributes": {
          "type": "object",
          "description": "Optional fallback attributes. Supported keys: defaultLocation, defaultVenueAddress.",
          "properties": {
            "defaultLocation": {
              "type": "string",
              "description": "Fallback event location when location is missing"
            },
            "defaultVenueAddress": {
              "type": "string",
              "description": "Fallback event venueAddress when venueAddress is missing"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "calendarStrategyOverride": {
      "type": "string",
      "enum": ["Auto"],
      "description": "Only Auto is currently supported (the default)."
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "name": "La Center Calendar",
      "description": "Public ICS feed from La Center, WA",
      "type": "Ics",
      "feedUrl": "https://calendar.google.com/calendar/ical/lacentercalendar%40gmail.com/public/basic.ics",
      "schemaDefinition": "{\"schemaVersion\":3,\"pipeline\":{\"calendar\":{\"type\":\"Ics\",\"parser\":{}},\"event\":{\"type\":\"None\",\"input\":{\"mode\":\"none\"},\"parser\":{}}}}",
      "metadata": {
        "location": "La Center, WA",
        "region": "WA",
        "category": "community",
        "eventStartNotBeforeDate": "2026-01-01",
        "eventFallbackUrl": "https://example.org/events",
        "customAttributes": {
          "defaultLocation": "123 Main St, La Center, WA 98629"
        }
      }
    },
    {
      "name": "Example Recreation Events",
      "description": "Community events from Example Org",
      "type": "Rss",
      "feedUrl": "https://example.org/events/feed.rss",
      "schemaDefinition": "{\"schemaVersion\":3,\"pipeline\":{\"calendar\":{\"type\":\"Rss\",\"parser\":{\"mappings\":{\"title\":\"title\",\"startTime\":\"pubDate\",\"eventUrl\":\"link\"}}},\"event\":{\"type\":\"None\",\"input\":{\"mode\":\"none\"},\"parser\":{}}}}",
      "metadata": {
        "location": "Example City",
        "region": "WA",
        "category": "community",
        "language": "en",
        "eventStartNotBeforeDate": "2026-01-01",
        "eventFallbackUrl": "https://example.org/events",
        "customAttributes": {
          "defaultVenueAddress": "456 Civic Way, Example City, WA 99999"
        }
      }
    }
  ]
}
